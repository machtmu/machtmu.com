{
  "ci": {
    "collect": {
      "staticDistDir": "./site",
      "url": [
        "http://localhost/",
        "http://localhost/team/",
        "http://localhost/sponsors/",
        "http://localhost/GAR-E/",
        "http://localhost/SPRINT/",
        "http://localhost/Seraphina/aug-6-hotfire/",
        "http://localhost/Seraphina/aug-20-hotfire/",
        "http://localhost/timeline/",
        "http://localhost/resources/"
      ],
      "numberOfRuns": 2,
      "settings": {
        "chromeFlags": "--headless --no-sandbox --disable-dev-shm-usage"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.6,
            "aggregationMethod": "median"
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95,
            "aggregationMethod": "median"
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95,
            "aggregationMethod": "median"
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.9,
            "aggregationMethod": "median"
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
